@model KategoriSecici.ViewModels.AnaSayfaViewModel
@using KategoriSecici.Models
@{
    var isEnglish = Model.Dil == "en";
    ViewData["Title"] = isEnglish ? "Media Lists" : "Medya Listeleri";

    string T(string tr, string en) => isEnglish ? en : tr;

    string KategoriAdi(MedyaKategori k) => k switch
    {
        MedyaKategori.Anime => "Anime",
        MedyaKategori.Manga => "Manga",
        MedyaKategori.Kitap => T("Kitap", "Book"),
        MedyaKategori.Dizi => T("Dizi", "Series"),
        MedyaKategori.Film => T("Film", "Movie"),
        MedyaKategori.Oyun => T("Oyun", "Game"),
        MedyaKategori.CizgiFilm => T("Cizgi Film", "Cartoon"),
        MedyaKategori.CizgiRoman => T("Cizgi Roman", "Comic"),
        MedyaKategori.Webtoon => "Webtoon",
        _ => k.ToString()
    };

    string KisaKod(MedyaKategori k) => k switch
    {
        MedyaKategori.Anime => "AN",
        MedyaKategori.Manga => "MA",
        MedyaKategori.Kitap => "KI",
        MedyaKategori.Dizi => "DI",
        MedyaKategori.Film => "FI",
        MedyaKategori.Oyun => "OY",
        MedyaKategori.CizgiFilm => "CF",
        MedyaKategori.CizgiRoman => "CR",
        MedyaKategori.Webtoon => "WT",
        _ => "--"
    };

    string? mesaj = TempData["Mesaj"] as string;
    string mesajTipi = TempData["MesajTipi"] as string ?? "info";

    string TamamlandiButonuMetni(MedyaKategori k) => k switch
    {
        MedyaKategori.Kitap => T("Okudum", "Read"),
        MedyaKategori.Manga => T("Okudum", "Read"),
        MedyaKategori.CizgiRoman => T("Okudum", "Read"),
        MedyaKategori.Webtoon => T("Okudum", "Read"),
        MedyaKategori.Oyun => T("Oynadim", "Played"),
        _ => T("Izledim", "Watched")
    };

    string TamamlananlarBasligi(MedyaKategori k) => k switch
    {
        MedyaKategori.Kitap => T("Okuduklarim", "Read Items"),
        MedyaKategori.Manga => T("Okuduklarim", "Read Items"),
        MedyaKategori.CizgiRoman => T("Okuduklarim", "Read Items"),
        MedyaKategori.Webtoon => T("Okuduklarim", "Read Items"),
        MedyaKategori.Oyun => T("Oynadiklarim", "Played Items"),
        _ => T("Izlediklerim", "Watched")
    };

    string OrnekMetin(MedyaKategori k) => k switch
    {
        MedyaKategori.Anime => "One Piece",
        MedyaKategori.Manga => "Berserk",
        MedyaKategori.Kitap => "1984",
        MedyaKategori.Dizi => "Breaking Bad",
        MedyaKategori.Film => "Interstellar",
        MedyaKategori.Oyun => "Elden Ring",
        MedyaKategori.CizgiFilm => "Shrek",
        MedyaKategori.CizgiRoman => "Batman: Year One",
        MedyaKategori.Webtoon => "Tower of God",
        _ => "Interstellar"
    };

    string BilgiYok() => T("Bilgi yok", "No data");
    string OzetYok() => T("Konu yok", "No summary");
    string TurEtiketi() => T("Tur", "Genre");
    string KonuEtiketi() => T("Konu", "Summary");
    string PuanEtiketi() => T("Puan", "Score");
    string FiyatEtiketi() => T("Fiyat", "Price");

    string LocalizeGenre(string? v)
    {
        if (string.IsNullOrWhiteSpace(v))
        {
            return string.Empty;
        }

        var value = v ?? string.Empty;
        if (isEnglish)
        {
            return value
                .Replace("Aksiyon", "Action", StringComparison.OrdinalIgnoreCase)
                .Replace("Macera", "Adventure", StringComparison.OrdinalIgnoreCase)
                .Replace("Bilim Kurgu", "Science Fiction", StringComparison.OrdinalIgnoreCase)
                .Replace("Dram", "Drama", StringComparison.OrdinalIgnoreCase)
                .Replace("Komedi", "Comedy", StringComparison.OrdinalIgnoreCase)
                .Replace("Romantik", "Romance", StringComparison.OrdinalIgnoreCase)
                .Replace("Korku", "Horror", StringComparison.OrdinalIgnoreCase)
                .Replace("Gizem", "Mystery", StringComparison.OrdinalIgnoreCase)
                .Replace("Gerilim", "Thriller", StringComparison.OrdinalIgnoreCase)
                .Replace("Fantastik", "Fantasy", StringComparison.OrdinalIgnoreCase)
                .Replace("Animasyon", "Animation", StringComparison.OrdinalIgnoreCase)
                .Replace("Suc", "Crime", StringComparison.OrdinalIgnoreCase)
                .Replace("Aile", "Family", StringComparison.OrdinalIgnoreCase)
                .Replace("Dogaustu", "Supernatural", StringComparison.OrdinalIgnoreCase)
                .Replace("RYO", "RPG", StringComparison.OrdinalIgnoreCase)
                .Replace("Cok Oyunculu", "MMO", StringComparison.OrdinalIgnoreCase)
                .Replace("Nisanci", "Shooter", StringComparison.OrdinalIgnoreCase)
                .Replace("Yaris", "Racing", StringComparison.OrdinalIgnoreCase)
                .Replace("Strateji", "Strategy", StringComparison.OrdinalIgnoreCase);
        }

        return value
            .Replace("Science Fiction", "Bilim Kurgu", StringComparison.OrdinalIgnoreCase)
            .Replace("Science-Fiction", "Bilim Kurgu", StringComparison.OrdinalIgnoreCase)
            .Replace("Action", "Aksiyon", StringComparison.OrdinalIgnoreCase)
            .Replace("Adventure", "Macera", StringComparison.OrdinalIgnoreCase)
            .Replace("Drama", "Dram", StringComparison.OrdinalIgnoreCase)
            .Replace("Comedy", "Komedi", StringComparison.OrdinalIgnoreCase)
            .Replace("Romance", "Romantik", StringComparison.OrdinalIgnoreCase)
            .Replace("Horror", "Korku", StringComparison.OrdinalIgnoreCase)
            .Replace("Mystery", "Gizem", StringComparison.OrdinalIgnoreCase)
            .Replace("Thriller", "Gerilim", StringComparison.OrdinalIgnoreCase)
            .Replace("Fantasy", "Fantastik", StringComparison.OrdinalIgnoreCase)
            .Replace("Animation", "Animasyon", StringComparison.OrdinalIgnoreCase)
            .Replace("Crime", "Suc", StringComparison.OrdinalIgnoreCase)
            .Replace("Family", "Aile", StringComparison.OrdinalIgnoreCase)
            .Replace("Supernatural", "Dogaustu", StringComparison.OrdinalIgnoreCase)
            .Replace("RPG", "RYO", StringComparison.OrdinalIgnoreCase)
            .Replace("MMO", "Cok Oyunculu", StringComparison.OrdinalIgnoreCase)
            .Replace("Shooter", "Nisanci", StringComparison.OrdinalIgnoreCase)
            .Replace("Racing", "Yaris", StringComparison.OrdinalIgnoreCase)
            .Replace("Strategy", "Strateji", StringComparison.OrdinalIgnoreCase);
    }

    string LocalizeSummary(string? v)
    {
        if (string.IsNullOrWhiteSpace(v))
        {
            return string.Empty;
        }

        var value = v ?? string.Empty;
        if (isEnglish)
        {
            return value
                .Replace("Yayin", "Published", StringComparison.OrdinalIgnoreCase)
                .Replace("Konu yok", "No summary", StringComparison.OrdinalIgnoreCase)
                .Replace("Bilgi yok", "No data", StringComparison.OrdinalIgnoreCase);
        }

        return value
            .Replace("No summary", "Konu yok", StringComparison.OrdinalIgnoreCase)
            .Replace("No data", "Bilgi yok", StringComparison.OrdinalIgnoreCase)
            .Replace("Published", "Yayin", StringComparison.OrdinalIgnoreCase);
    }

    var oyunKategori = Model.SeciliKategori == MedyaKategori.Oyun;
    var kitapKategori = Model.SeciliKategori == MedyaKategori.Kitap || Model.SeciliKategori == MedyaKategori.CizgiRoman || Model.SeciliKategori == MedyaKategori.Webtoon;
    var puanGoster = !oyunKategori && !kitapKategori;
}

<div class="dashboard-page">
<div class="dashboard-layout">
    <aside class="category-sidebar" aria-label="categories">
        <div class="sidebar-label">@T("Kategoriler", "Categories")</div>

        <nav class="category-links">
            @foreach (var kategori in Enum.GetValues<MedyaKategori>())
            {
                var isActive = kategori == Model.SeciliKategori;
                <a asp-action="Index"
                   asp-route-lang="@Model.Dil"
                   asp-route-kategori="@kategori"
                   class="category-link @(isActive ? "active" : string.Empty)">
                    <span class="category-icon">@KisaKod(kategori)</span>
                    <span class="category-text">@KategoriAdi(kategori)</span>
                    <span class="category-count">@(Model.KategoriAdetleri.TryGetValue(kategori, out var adet) ? adet : 0)</span>
                </a>
            }
        </nav>
    </aside>

    <section class="category-main">
        <div class="mb-4">
            <h1 class="mb-1">@KategoriAdi(Model.SeciliKategori)</h1>
            <p class="text-muted mb-0">@T("Bu kategorideki listeyi goruntuluyorsun.", "You are viewing this category list.")</p>
        </div>

        <div class="category-content-layout">
            <div class="category-primary-column">
                @if (!string.IsNullOrWhiteSpace(mesaj))
                {
                    <div class="alert alert-@mesajTipi" role="alert">@mesaj</div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.RastgeleSecilenOge))
                {
                    <div class="card mb-3 category-list-card random-result-card">
                        <div class="card-body">
                            <h2 class="h5 mb-3">@T("Secilen", "Selected")</h2>
                            @if (Model.RastgeleSecilenDetay is not null)
                            {
                                <article class="media-item-card">
                                    <div class="media-item-poster-wrap">
                                        <a asp-action="Detay"
                                           asp-route-lang="@Model.Dil"
                                           asp-route-kategori="@Model.SeciliKategori"
                                           asp-route-id="@Model.RastgeleSecilenDetay.Id">
                                            @if (!string.IsNullOrWhiteSpace(Model.RastgeleSecilenDetay.PosterUrl))
                                            {
                                                <img src="@Model.RastgeleSecilenDetay.PosterUrl" alt="@Model.RastgeleSecilenDetay.Ad" class="media-item-poster" loading="lazy" />
                                            }
                                            else
                                            {
                                                <div class="media-item-poster media-item-poster-empty">@T("Poster yok", "No poster")</div>
                                            }
                                        </a>
                                    </div>
                                    <div class="media-item-content">
                                        <h3 class="media-item-title">
                                            <a asp-action="Detay"
                                               asp-route-lang="@Model.Dil"
                                               asp-route-kategori="@Model.SeciliKategori"
                                               asp-route-id="@Model.RastgeleSecilenDetay.Id">
                                                @Model.RastgeleSecilenDetay.Ad
                                            </a>
                                        </h3>
                                        <p class="media-item-line"><strong>@TurEtiketi():</strong> @(string.IsNullOrWhiteSpace(Model.RastgeleSecilenDetay.Tur) ? BilgiYok() : LocalizeGenre(Model.RastgeleSecilenDetay.Tur))</p>
                                        <p class="media-item-line media-item-summary"><strong>@KonuEtiketi():</strong> @(string.IsNullOrWhiteSpace(Model.RastgeleSecilenDetay.Konu) ? OzetYok() : LocalizeSummary(Model.RastgeleSecilenDetay.Konu))</p>
                                        @if (oyunKategori)
                                        {
                                            <p class="media-item-line"><strong>@FiyatEtiketi():</strong> @(string.IsNullOrWhiteSpace(Model.RastgeleSecilenDetay.Fiyat) ? BilgiYok() : Model.RastgeleSecilenDetay.Fiyat)</p>
                                        }
                                        else if (puanGoster)
                                        {
                                            <p class="media-item-line"><strong>@PuanEtiketi():</strong> @(string.IsNullOrWhiteSpace(Model.RastgeleSecilenDetay.Puan) ? BilgiYok() : Model.RastgeleSecilenDetay.Puan)</p>
                                        }
                                    </div>
                                </article>
                            }
                            else
                            {
                                <div class="alert alert-success mb-0" role="alert">
                                    <strong>@T("Rastgele Secim:", "Random Pick:")</strong> @Model.RastgeleSecilenOge
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="card mb-4 category-form-card">
                    <div class="card-body">
                        <h2 class="h5">@T("Bu kategoriye oge ekle", "Add item to this category")</h2>
                        <div class="category-action-row">
                            <form asp-action="Ekle" method="post" class="add-item-form">
                                <input type="hidden" name="Dil" value="@Model.Dil" />
                                <input type="hidden" name="SeciliKategori" value="@Model.SeciliKategori" />
                                <input type="hidden" id="selectedPosterUrl" name="YeniOgePosterUrl" />
                                <input type="hidden" id="selectedGenre" name="YeniOgeTur" />
                                <input type="hidden" id="selectedSummary" name="YeniOgeKonu" />
                                <input type="hidden" id="selectedScore" name="YeniOgePuan" />
                                <input type="hidden" id="selectedPrice" name="YeniOgeFiyat" />
                                <div class="add-input-wrap">
                                    <input class="form-control"
                                           id="catalogSearchInput"
                                           name="YeniOgeAdi"
                                           autocomplete="off"
                                           placeholder="@T($"Orn: {OrnekMetin(Model.SeciliKategori)}", $"Ex: {OrnekMetin(Model.SeciliKategori)}")" />
                                    <div id="catalogSearchResults" class="catalog-search-results d-none"></div>
                                </div>
                                <div class="add-button-wrap">
                                    <button class="btn btn-primary" type="submit">@T("Ekle", "Add")</button>
                                </div>
                            </form>

                            <form asp-action="RastgeleSec" method="post" class="random-form-inline">
                                <input type="hidden" name="dil" value="@Model.Dil" />
                                <input type="hidden" name="kategori" value="@Model.SeciliKategori" />
                                <button type="submit" class="btn btn-success random-inline-btn">@T("Rastgele Sec", "Pick Random")</button>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="card category-list-card">
                    <div class="card-body">
                        <h2 class="h5">@T("Liste", "List")</h2>

                        @if (Model.SeciliKategoriListeOgeleri.Count == 0)
                        {
                            <p class="text-muted mb-0">@T("Bu kategoride henuz kayit yok.", "No items in this category yet.")</p>
                        }
                        else
                        {
                            <div class="media-item-list">
                                @foreach (var item in Model.SeciliKategoriListeOgeleri)
                                {
                                    <article class="media-item-card">
                                        <div class="media-item-poster-wrap">
                                            <a asp-action="Detay"
                                               asp-route-lang="@Model.Dil"
                                               asp-route-kategori="@Model.SeciliKategori"
                                               asp-route-id="@item.Id">
                                                @if (!string.IsNullOrWhiteSpace(item.PosterUrl))
                                                {
                                                    <img src="@item.PosterUrl" alt="@item.Ad" class="media-item-poster" loading="lazy" />
                                                }
                                                else
                                                {
                                                    <div class="media-item-poster media-item-poster-empty">@T("Poster yok", "No poster")</div>
                                                }
                                            </a>
                                        </div>
                                        <div class="media-item-content">
                                            <h3 class="media-item-title">
                                                <a asp-action="Detay"
                                                   asp-route-lang="@Model.Dil"
                                                   asp-route-kategori="@Model.SeciliKategori"
                                                   asp-route-id="@item.Id">
                                                    @item.Ad
                                                </a>
                                            </h3>
                                            <p class="media-item-line"><strong>@TurEtiketi():</strong> @(string.IsNullOrWhiteSpace(item.Tur) ? BilgiYok() : LocalizeGenre(item.Tur))</p>
                                            <p class="media-item-line media-item-summary"><strong>@KonuEtiketi():</strong> @(string.IsNullOrWhiteSpace(item.Konu) ? OzetYok() : LocalizeSummary(item.Konu))</p>
                                            @if (oyunKategori)
                                            {
                                                <p class="media-item-line"><strong>@FiyatEtiketi():</strong> @(string.IsNullOrWhiteSpace(item.Fiyat) ? BilgiYok() : item.Fiyat)</p>
                                            }
                                            else if (puanGoster)
                                            {
                                                <p class="media-item-line"><strong>@PuanEtiketi():</strong> @(string.IsNullOrWhiteSpace(item.Puan) ? BilgiYok() : item.Puan)</p>
                                            }
                                        </div>
                                        <div class="media-item-actions">
                                            <form asp-action="IzledimYap" method="post" class="m-0">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="kategori" value="@Model.SeciliKategori" />
                                                <input type="hidden" name="dil" value="@Model.Dil" />
                                                <button type="submit" class="btn btn-sm btn-warning">@TamamlandiButonuMetni(Model.SeciliKategori)</button>
                                            </form>
                                            <form asp-action="Sil" method="post" class="m-0">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="kategori" value="@Model.SeciliKategori" />
                                                <input type="hidden" name="dil" value="@Model.Dil" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">@T("Cikar", "Remove")</button>
                                            </form>
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <aside class="card watched-panel category-list-card">
                <div class="card-body">
                    <h2 class="h5 mb-3">@TamamlananlarBasligi(Model.SeciliKategori)</h2>
                    @if (Model.SeciliKategoriIzlenenOgeleri.Count == 0)
                    {
                        <p class="text-muted mb-0">@T("Bu kategoride henuz kayit yok.", "No items in this category yet.")</p>
                    }
                    else
                    {
                        <div class="media-item-list">
                            @foreach (var item in Model.SeciliKategoriIzlenenOgeleri)
                            {
                                <article class="media-item-card">
                                    <div class="media-item-poster-wrap">
                                        <a asp-action="Detay"
                                           asp-route-lang="@Model.Dil"
                                           asp-route-kategori="@Model.SeciliKategori"
                                           asp-route-id="@item.Id">
                                            @if (!string.IsNullOrWhiteSpace(item.PosterUrl))
                                            {
                                                <img src="@item.PosterUrl" alt="@item.Ad" class="media-item-poster" loading="lazy" />
                                            }
                                            else
                                            {
                                                <div class="media-item-poster media-item-poster-empty">@T("Poster yok", "No poster")</div>
                                            }
                                        </a>
                                    </div>
                                    <div class="media-item-content">
                                        <h3 class="media-item-title">
                                            <a asp-action="Detay"
                                               asp-route-lang="@Model.Dil"
                                               asp-route-kategori="@Model.SeciliKategori"
                                               asp-route-id="@item.Id">
                                                @item.Ad
                                            </a>
                                        </h3>
                                        <p class="media-item-line"><strong>@TurEtiketi():</strong> @(string.IsNullOrWhiteSpace(item.Tur) ? BilgiYok() : LocalizeGenre(item.Tur))</p>
                                        <p class="media-item-line media-item-summary"><strong>@KonuEtiketi():</strong> @(string.IsNullOrWhiteSpace(item.Konu) ? OzetYok() : LocalizeSummary(item.Konu))</p>
                                        @if (oyunKategori)
                                        {
                                            <p class="media-item-line"><strong>@FiyatEtiketi():</strong> @(string.IsNullOrWhiteSpace(item.Fiyat) ? BilgiYok() : item.Fiyat)</p>
                                        }
                                        else if (puanGoster)
                                        {
                                            <p class="media-item-line"><strong>@PuanEtiketi():</strong> @(string.IsNullOrWhiteSpace(item.Puan) ? BilgiYok() : item.Puan)</p>
                                        }
                                    </div>
                                    <div class="media-item-actions">
                                        <form asp-action="ListeyeGeriAl" method="post" class="m-0">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="kategori" value="@Model.SeciliKategori" />
                                            <input type="hidden" name="dil" value="@Model.Dil" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">@T("Listeye Al", "Move to List")</button>
                                        </form>
                                    </div>
                                </article>
                            }
                        </div>
                    }
                </div>
            </aside>
        </div>
    </section>
</div>
</div>

@section Scripts {
<script>
(() => {
  const input = document.getElementById('catalogSearchInput');
  const resultsBox = document.getElementById('catalogSearchResults');
  const selectedPoster = document.getElementById('selectedPosterUrl');
  const selectedGenre = document.getElementById('selectedGenre');
  const selectedSummary = document.getElementById('selectedSummary');
  const selectedScore = document.getElementById('selectedScore');
  const selectedPrice = document.getElementById('selectedPrice');
  if (!input || !resultsBox) return;

  const lang = '@Model.Dil';
  const kategori = '@Model.SeciliKategori';
  const scoreLabel = lang === 'en' ? 'Score' : 'Puan';
  const priceLabel = lang === 'en' ? 'Price' : 'Fiyat';
  let timer = null;
  let reqId = 0;

  function esc(v) {
    return (v || '').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  }

  function hideResults() {
    resultsBox.innerHTML = '';
    resultsBox.classList.add('d-none');
  }

  function clearSelectedMeta() {
    if (selectedPoster) selectedPoster.value = '';
    if (selectedGenre) selectedGenre.value = '';
    if (selectedSummary) selectedSummary.value = '';
    if (selectedScore) selectedScore.value = '';
    if (selectedPrice) selectedPrice.value = '';
  }

  function renderItems(data) {
    const items = (data && data.items) ? data.items : [];
    const message = data && data.message ? data.message : '';

    if (!items.length) {
      if (!message) {
        hideResults();
        return;
      }
      resultsBox.innerHTML = `<div class="catalog-no-result">${esc(message)}</div>`;
      resultsBox.classList.remove('d-none');
      return;
    }

    const html = items.map(item => {
      const name = esc(item.name || '');
      const rawName = item.name || '';
      const altName = esc(item.altName || '');
      const score = esc(item.score || '');
      const summary = esc(item.summary || '');
      const genre = esc(item.genre || item.altName || '');
      const price = esc(item.price || '');
      const poster = esc(item.posterUrl || '');
      const detailUrl = `/Home/Detay?lang=${encodeURIComponent(lang)}&kategori=${encodeURIComponent(kategori)}&ad=${encodeURIComponent(rawName)}`;
      return `
        <a class="catalog-result-item"
          href="${detailUrl}"
          data-name="${name}"
          data-poster="${poster}"
          data-genre="${genre}"
          data-summary="${summary}"
          data-score="${score}"
          data-price="${price}">
          ${poster ? `<img src="${poster}" alt="" class="catalog-thumb" loading="lazy" />` : `<span class="catalog-thumb catalog-thumb-empty"></span>`}
          <span class="catalog-meta">
            <span class="catalog-title">${name}</span>
            ${genre ? `<span class="catalog-sub">${genre}</span>` : ''}
            ${summary ? `<span class="catalog-sub">${summary}</span>` : ''}
            ${score ? `<span class="catalog-sub">${scoreLabel}: ${score}</span>` : ''}
            ${price ? `<span class="catalog-sub">${priceLabel}: ${price}</span>` : ''}
          </span>
        </a>
      `;
    }).join('');

    resultsBox.innerHTML = html;
    resultsBox.classList.remove('d-none');
  }

  input.addEventListener('input', () => {
    clearSelectedMeta();
    const q = input.value.trim();
    if (q.length < 1) {
      hideResults();
      return;
    }

    clearTimeout(timer);
    timer = setTimeout(async () => {
      const currentReq = ++reqId;
      try {
        const url = `/Home/SearchCatalog?lang=${encodeURIComponent(lang)}&kategori=${encodeURIComponent(kategori)}&q=${encodeURIComponent(q)}`;
        const res = await fetch(url, { headers: { 'Accept': 'application/json' } });
        if (!res.ok) return;
        const data = await res.json();
        if (currentReq !== reqId) return;
        renderItems(data);
      } catch (_) {}
    }, 120);
  });

  document.addEventListener('click', (e) => {
    if (!resultsBox.contains(e.target) && e.target !== input) {
      hideResults();
    }
  });
})();
</script>
}



