@model KategoriSecici.ViewModels.AnaSayfaViewModel
@using KategoriSecici.Models
@{
    var isEnglish = Model.Dil == "en";
    ViewData["Title"] = isEnglish ? "Media Lists" : "Medya Listeleri";

    string T(string tr, string en) => isEnglish ? en : tr;

    string KategoriAdi(MedyaKategori k) => k switch
    {
        MedyaKategori.Anime => "Anime",
        MedyaKategori.Manga => "Manga",
        MedyaKategori.Kitap => T("Kitap", "Book"),
        MedyaKategori.Dizi => T("Dizi", "Series"),
        MedyaKategori.Film => T("Film", "Movie"),
        MedyaKategori.Oyun => T("Oyun", "Game"),
        _ => k.ToString()
    };

    string KisaKod(MedyaKategori k) => k switch
    {
        MedyaKategori.Anime => "AN",
        MedyaKategori.Manga => "MA",
        MedyaKategori.Kitap => "KI",
        MedyaKategori.Dizi => "DI",
        MedyaKategori.Film => "FI",
        MedyaKategori.Oyun => "OY",
        _ => "--"
    };

    string? mesaj = TempData["Mesaj"] as string;
    string mesajTipi = TempData["MesajTipi"] as string ?? "info";

    string TamamlandiButonuMetni(MedyaKategori k) => k switch
    {
        MedyaKategori.Kitap => T("Okudum", "Read"),
        MedyaKategori.Manga => T("Okudum", "Read"),
        MedyaKategori.Oyun => T("Oynadim", "Played"),
        _ => T("Izledim", "Watched")
    };

    string TamamlananlarBasligi(MedyaKategori k) => k switch
    {
        MedyaKategori.Kitap => T("Okuduklarim", "Read Items"),
        MedyaKategori.Manga => T("Okuduklarim", "Read Items"),
        MedyaKategori.Oyun => T("Oynadiklarim", "Played Items"),
        _ => T("Izlediklerim", "Watched")
    };
}

<div class="dashboard-page">
<div class="dashboard-layout">
    <aside class="category-sidebar" aria-label="categories">
        <div class="sidebar-label">@T("Kategoriler", "Categories")</div>

        <nav class="category-links">
            @foreach (var kategori in Enum.GetValues<MedyaKategori>())
            {
                var isActive = kategori == Model.SeciliKategori;
                <a asp-action="Index"
                   asp-route-lang="@Model.Dil"
                   asp-route-kategori="@kategori"
                   class="category-link @(isActive ? "active" : string.Empty)">
                    <span class="category-icon">@KisaKod(kategori)</span>
                    <span class="category-text">@KategoriAdi(kategori)</span>
                    <span class="category-count">@(Model.KategoriAdetleri.TryGetValue(kategori, out var adet) ? adet : 0)</span>
                </a>
            }
        </nav>
    </aside>

    <section class="category-main">
        <div class="mb-4">
            <h1 class="mb-1">@KategoriAdi(Model.SeciliKategori)</h1>
            <p class="text-muted mb-0">@T("Bu kategorideki listeyi goruntuluyorsun.", "You are viewing this category list.")</p>
        </div>

        <div class="category-content-layout">
            <div class="category-primary-column">
                @if (!string.IsNullOrWhiteSpace(mesaj))
                {
                    <div class="alert alert-@mesajTipi" role="alert">@mesaj</div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.RastgeleSecilenOge))
                {
                    <div class="alert alert-success" role="alert">
                        <strong>@T("Rastgele Secim:", "Random Pick:")</strong> @Model.RastgeleSecilenOge
                    </div>
                }

                <div class="card mb-4 category-form-card">
                    <div class="card-body">
                        <h2 class="h5">@T("Bu kategoriye oge ekle", "Add item to this category")</h2>
                        <div class="category-action-row">
                            <form asp-action="Ekle" method="post" class="add-item-form">
                                <input type="hidden" name="Dil" value="@Model.Dil" />
                                <input type="hidden" name="SeciliKategori" value="@Model.SeciliKategori" />
                                <div class="add-input-wrap">
                                    <input class="form-control"
                                           id="catalogSearchInput"
                                           name="YeniOgeAdi"
                                           autocomplete="off"
                                           placeholder="@T("Orn: Interstellar", "Ex: Interstellar")" />
                                    <div id="catalogSearchResults" class="catalog-search-results d-none"></div>
                                </div>
                                <div class="add-button-wrap">
                                    <button class="btn btn-primary" type="submit">@T("Ekle", "Add")</button>
                                </div>
                            </form>

                            <form asp-action="RastgeleSec" method="post" class="random-form-inline">
                                <input type="hidden" name="dil" value="@Model.Dil" />
                                <input type="hidden" name="kategori" value="@Model.SeciliKategori" />
                                <button type="submit" class="btn btn-success random-inline-btn">@T("Rastgele Sec", "Pick Random")</button>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="card category-list-card">
                    <div class="card-body">
                        <h2 class="h5">@T("Liste", "List")</h2>

                        @if (Model.SeciliKategoriListeOgeleri.Count == 0)
                        {
                            <p class="text-muted mb-0">@T("Bu kategoride henuz kayit yok.", "No items in this category yet.")</p>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var item in Model.SeciliKategoriListeOgeleri)
                                {
                                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center gap-2">
                                        <span>@item.Ad</span>
                                        <div class="d-flex align-items-center gap-2">
                                            <form asp-action="IzledimYap" method="post" class="m-0">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="kategori" value="@Model.SeciliKategori" />
                                                <input type="hidden" name="dil" value="@Model.Dil" />
                                                <button type="submit" class="btn btn-sm btn-warning">@TamamlandiButonuMetni(Model.SeciliKategori)</button>
                                            </form>
                                            <form asp-action="Sil" method="post" class="m-0">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="kategori" value="@Model.SeciliKategori" />
                                                <input type="hidden" name="dil" value="@Model.Dil" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">@T("Cikar", "Remove")</button>
                                            </form>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>

            <aside class="card watched-panel category-list-card">
                <div class="card-body">
                    <h2 class="h5 mb-3">@TamamlananlarBasligi(Model.SeciliKategori)</h2>
                    @if (Model.SeciliKategoriIzlenenOgeleri.Count == 0)
                    {
                        <p class="text-muted mb-0">@T("Bu kategoride henuz kayit yok.", "No items in this category yet.")</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var item in Model.SeciliKategoriIzlenenOgeleri)
                            {
                                <li class="list-group-item px-0 d-flex justify-content-between align-items-center gap-2">
                                    <span>@item.Ad</span>
                                    <form asp-action="ListeyeGeriAl" method="post" class="m-0">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="kategori" value="@Model.SeciliKategori" />
                                        <input type="hidden" name="dil" value="@Model.Dil" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">@T("Listeye Al", "Move to List")</button>
                                    </form>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </aside>
        </div>
    </section>
</div>
</div>

@section Scripts {
<script>
(() => {
  const input = document.getElementById('catalogSearchInput');
  const resultsBox = document.getElementById('catalogSearchResults');
  if (!input || !resultsBox) return;

  const lang = '@Model.Dil';
  const kategori = '@Model.SeciliKategori';
  let timer = null;
  let reqId = 0;

  function esc(v) {
    return (v || '').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  }

  function hideResults() {
    resultsBox.innerHTML = '';
    resultsBox.classList.add('d-none');
  }

  function renderItems(data) {
    const items = (data && data.items) ? data.items : [];
    const message = data && data.message ? data.message : '';

    if (!items.length) {
      if (!message) {
        hideResults();
        return;
      }
      resultsBox.innerHTML = `<div class="catalog-no-result">${esc(message)}</div>`;
      resultsBox.classList.remove('d-none');
      return;
    }

    const html = items.map(item => {
      const name = esc(item.name || '');
      const altName = esc(item.altName || '');
      const score = esc(item.score || '');
      const poster = esc(item.posterUrl || '');
      return `
        <button type="button" class="catalog-result-item" data-name="${name}">
          ${poster ? `<img src="${poster}" alt="" class="catalog-thumb" loading="lazy" />` : `<span class="catalog-thumb catalog-thumb-empty"></span>`}
          <span class="catalog-meta">
            <span class="catalog-title">${name}</span>
            ${altName ? `<span class="catalog-sub">${altName}</span>` : ''}
            ${score ? `<span class="catalog-sub">Score: ${score}</span>` : ''}
          </span>
        </button>
      `;
    }).join('');

    resultsBox.innerHTML = html;
    resultsBox.classList.remove('d-none');

    resultsBox.querySelectorAll('.catalog-result-item').forEach(btn => {
      btn.addEventListener('click', () => {
        input.value = btn.getAttribute('data-name') || '';
        hideResults();
        input.focus();
      });
    });
  }

  input.addEventListener('input', () => {
    const q = input.value.trim();
    if (q.length < 2) {
      hideResults();
      return;
    }

    clearTimeout(timer);
    timer = setTimeout(async () => {
      const currentReq = ++reqId;
      try {
        const url = `/Home/SearchCatalog?lang=${encodeURIComponent(lang)}&kategori=${encodeURIComponent(kategori)}&q=${encodeURIComponent(q)}`;
        const res = await fetch(url, { headers: { 'Accept': 'application/json' } });
        if (!res.ok) return;
        const data = await res.json();
        if (currentReq !== reqId) return;
        renderItems(data);
      } catch (_) {}
    }, 260);
  });

  document.addEventListener('click', (e) => {
    if (!resultsBox.contains(e.target) && e.target !== input) {
      hideResults();
    }
  });
})();
</script>
}
