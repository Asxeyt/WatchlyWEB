@{
    var lang = (ViewData["Lang"] as string ?? "tr").ToLowerInvariant();
    if (lang != "en")
    {
        lang = "tr";
    }

    ViewData["Title"] = lang == "en" ? "Settings" : "Ayarlar";
    string T(string tr, string en) => lang == "en" ? en : tr;
}

<div class="mb-4">
    <h1 class="mb-2">@T("Ayarlar", "Settings")</h1>
</div>

<div class="card mb-3 settings-panel">
    <div class="card-body">
        <div class="dropdown settings-option">
            <button class="btn btn-outline-dark dropdown-toggle settings-button" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                @T("Dil", "Language")
            </button>
            <ul class="dropdown-menu settings-menu">
                <li><a class="dropdown-item" asp-controller="Home" asp-action="Index" asp-route-lang="tr" asp-route-kategori="Film">Turkce</a></li>
                <li><a class="dropdown-item" asp-controller="Home" asp-action="Index" asp-route-lang="en" asp-route-kategori="Film">English</a></li>
            </ul>
        </div>

        <div class="dropdown mt-3 settings-option">
            <button class="btn btn-outline-dark dropdown-toggle settings-button" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                @T("Tema", "Theme")
            </button>
            <ul class="dropdown-menu settings-menu">
                <li><button type="button" class="dropdown-item" onclick="setTheme('dark')">Dark</button></li>
                <li><button type="button" class="dropdown-item" onclick="setTheme('light')">Light</button></li>
            </ul>
        </div>

        <div class="mt-3 settings-option settings-music-row">
            <div class="dropdown">
                <button class="btn btn-outline-dark dropdown-toggle settings-button" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    @T("Muzik", "Music")
                </button>
                <ul class="dropdown-menu settings-menu">
                    <li><button type="button" class="dropdown-item" onclick="setMusic('on')">@T("Ac", "On")</button></li>
                    <li><button type="button" class="dropdown-item" onclick="setMusic('off')">@T("Kapat", "Off")</button></li>
                </ul>
            </div>
            <div class="settings-volume-panel" aria-label="@T("Ses ayari", "Volume control")">
                <label for="musicVolumeRange" class="settings-volume-label">@T("Ses", "Volume")</label>
                <input id="musicVolumeRange" type="range" min="0" max="100" step="1" value="35" oninput="setMusicVolume(this.value)" />
            </div>
        </div>
    </div>
</div>
