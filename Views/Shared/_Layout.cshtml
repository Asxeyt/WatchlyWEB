@{
    var lang = (ViewData["Lang"] as string ?? Context.Request.Query["lang"].ToString()).ToLowerInvariant();
    var selectedCategory = ViewData["SelectedCategory"] as string;
    if (lang != "en")
    {
        lang = "tr";
    }
    bool isEnglish = lang == "en";
    string T(string tr, string en) => isEnglish ? en : tr;
}
<!DOCTYPE html>
<html lang="@(isEnglish ? "en" : "tr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KategoriSecici</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/KategoriSecici.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index" asp-route-lang="@lang">KategoriSecici</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="mainNav" class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index" asp-route-lang="@lang">@T("Anasayfa", "Home")</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="settingsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @T("Ayarlar", "Settings")
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="settingsDropdown">
                                <li>
                                    <a class="dropdown-item" asp-controller="Home" asp-action="Settings" asp-route-lang="@lang">@T("Ayarlar Sayfasi", "Settings Page")</a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item @(isEnglish ? "" : "active")" asp-controller="Home" asp-action="Index" asp-route-lang="tr" asp-route-kategori="@selectedCategory">Turkce</a>
                                </li>
                                <li>
                                    <a class="dropdown-item @(isEnglish ? "active" : "")" asp-controller="Home" asp-action="Index" asp-route-lang="en" asp-route-kategori="@selectedCategory">English</a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - KategoriSecici
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
