@using KategoriSecici.Models
@{
    var lang = (ViewData["Lang"] as string ?? Context.Request.Query["lang"].ToString()).ToLowerInvariant();
    var hideTopNav = (ViewData["HideTopNav"] as bool?) == true;
    if (lang != "en")
    {
        lang = "tr";
    }
    string T(string tr, string en) => lang == "en" ? en : tr;
    var isAuth = User.Identity?.IsAuthenticated == true;
    var userDisplay = User.Identity?.Name ?? (lang == "en" ? "Profile" : "Profil");
}
<!DOCTYPE html>
<html lang="@lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="application-version" content="@WatchlyRelease.Version" />
    <meta name="author" content="@WatchlyRelease.Author" />
    <title>@ViewData["Title"] - Watchly</title>
    <script>
        (function () {
            var theme = localStorage.getItem('theme') || 'dark';
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/KategoriSecici.styles.css" asp-append-version="true" />
</head>
<body class="@(ViewData["BodyClass"] as string ?? string.Empty)">
    @if (!hideTopNav)
    {
        <header>
            <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
                <div class="container-fluid">
                    <a class="navbar-brand watchly-brand" asp-area="" asp-controller="Home" asp-action="RastgeleKategori" asp-route-lang="@lang">
                        <img src="~/images/watchly-logo.png" alt="Watchly logo" asp-append-version="true" />
                        <span>Watchly</span>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div id="mainNav" class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav ms-auto align-items-center">
                            <li class="nav-item dropdown me-3">
                                <button class="nav-link text-dark settings-nav-link dropdown-toggle btn btn-link" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="settings-icon" aria-hidden="true">&#9881;</span>
                                    <span>@T("Ayarlar", "Settings")</span>
                                </button>
                                <div class="dropdown-menu dropdown-menu-end p-3 quick-settings-menu">
                                    <div class="quick-section-title">@T("Dil", "Language")</div>
                                    <div class="d-flex gap-2 mb-3">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setLanguage('tr')">Turkce</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setLanguage('en')">English</button>
                                    </div>

                                    <div class="quick-section-title">@T("Tema", "Theme")</div>
                                    <div class="d-flex gap-2 mb-3">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setTheme('dark')">Dark</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setTheme('light')">Light</button>
                                    </div>

                                    <div class="quick-section-title">@T("Muzik", "Music")</div>
                                    <div class="d-flex gap-2 mb-2">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setMusic('on')">@T("Ac", "On")</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setMusic('off')">@T("Kapat", "Off")</button>
                                    </div>
                                    <input type="range" min="0" max="100" step="1" value="35" data-music-volume class="form-range mb-0" />
                                </div>
                            </li>

                            <li class="nav-item dropdown">
                                <button class="nav-link text-dark profile-nav-link dropdown-toggle btn btn-link p-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="profile-avatar" aria-hidden="true">@((userDisplay.Length > 0 ? userDisplay[0] : 'P').ToString().ToUpper())</span>
                                    <span>@(isAuth ? userDisplay : T("Profil", "Profile"))</span>
                                </button>
                                <div class="dropdown-menu dropdown-menu-end p-0 profile-menu">
                                    @if (!isAuth)
                                    {
                                        <div class="profile-block">
                                            <p class="mb-2 fw-bold">@T("Kayitli profil yok", "No registered profile")</p>
                                            <a class="btn btn-warning btn-sm me-2" asp-controller="Account" asp-action="Register" asp-route-lang="@lang">@T("Kaydol", "Sign up")</a>
                                            <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login" asp-route-lang="@lang">@T("Giris", "Sign in")</a>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="profile-block border-bottom">
                                            <p class="profile-name">@userDisplay</p>
                                            <p class="profile-handle">@T("Kisisel profil", "Personal profile")</p>
                                        </div>
                                        <div class="profile-block d-grid gap-2">
                                            <a class="btn btn-outline-secondary btn-sm" asp-controller="Account" asp-action="Profile" asp-route-lang="@lang">@T("Profilimi Ac", "Open Profile")</a>
                                            <form asp-controller="Account" asp-action="Logout" asp-route-lang="@lang" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger btn-sm w-100">@T("Oturumu kapat", "Sign out")</button>
                                            </form>
                                            <button type="button" class="btn btn-dark btn-sm w-100" data-bs-toggle="modal" data-bs-target="#deleteAccountModal">@T("Hesabı sil", "Delete account")</button>
                                        </div>
                                    }
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
    }
    @if (TempData["AccountDeleteError"] is string accountDeleteError && !string.IsNullOrWhiteSpace(accountDeleteError))
    {
        <div class="container mb-2">
            <div class="alert alert-warning py-2 mb-0">@accountDeleteError</div>
        </div>
    }
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="watchly-release-signature" aria-label="Watchly release signature">
        @WatchlyRelease.Display
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (!hideTopNav && isAuth)
    {
        <div class="modal fade" id="deleteAccountModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@T("Hesabı sil", "Delete account")</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form asp-controller="Account" asp-action="DeleteAccount" method="post">
                        @Html.AntiForgeryToken()
                        <div class="modal-body">
                            <input type="hidden" name="Lang" value="@lang" />
                            <p class="mb-2 fw-semibold">@T("Hesabi silmek istedigine emin misin?", "Are you sure you want to delete your account?")</p>
                            <p class="mb-2 text-danger">@T("Bu islem geri alinmaz. Silersen e-posta, kullanici adi, sifre ve tum liste verilerin kalici olarak silinir.", "This cannot be undone. If you delete it, your e-mail, username, password, and all list data will be permanently removed.")</p>
                            <input type="password" name="Password" class="form-control" required />
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@T("Vazgec", "Cancel")</button>
                            <button type="submit" class="btn btn-danger">@T("Sil", "Delete")</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
