@{
    var lang = (ViewData["Lang"] as string ?? Context.Request.Query["lang"].ToString()).ToLowerInvariant();
    var selectedCategory = ViewData["SelectedCategory"] as string;
    if (lang != "en")
    {
        lang = "tr";
    }
    string T(string tr, string en) => lang == "en" ? en : tr;
}
<!DOCTYPE html>
<html lang="@lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KategoriSecici</title>
    <script>
        (function () {
            var theme = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/KategoriSecici.styles.css" asp-append-version="true" />
</head>
<body class="@(ViewData["BodyClass"] as string ?? string.Empty)">
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="RastgeleKategori" asp-route-lang="@lang">KategoriSecici</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="mainNav" class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Anasayfa" asp-route-lang="@lang">@T("Anasayfa", "Home")</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item dropdown me-2">
                            <button class="nav-link text-dark settings-nav-link dropdown-toggle btn btn-link" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="settings-icon" aria-hidden="true">&#9881;</span>
                                <span>@T("Ayarlar", "Settings")</span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end p-3 quick-settings-menu">
                                <div class="quick-section-title">@T("Dil", "Language")</div>
                                <div class="d-flex gap-2 mb-3">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setLanguage('tr')">Turkce</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setLanguage('en')">English</button>
                                </div>

                                <div class="quick-section-title">@T("Tema", "Theme")</div>
                                <div class="d-flex gap-2 mb-3">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setTheme('dark')">Dark</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setTheme('light')">Light</button>
                                </div>

                                <div class="quick-section-title">@T("Muzik", "Music")</div>
                                <div class="d-flex gap-2 mb-2">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setMusic('on')">@T("Ac", "On")</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setMusic('off')">@T("Kapat", "Off")</button>
                                </div>
                                <input type="range" min="0" max="100" step="1" value="35" data-music-volume class="form-range mb-0" />
                            </div>
                        </li>
                        <li class="nav-item dropdown">
                            <button class="nav-link text-dark profile-nav-link dropdown-toggle btn btn-link p-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="profile-avatar js-profile-avatar" aria-hidden="true">P</span>
                                <span id="profileNavText">@T("Profil", "Profile")</span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end p-0 profile-menu" id="profileMenuContent">
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <div class="modal fade" id="profileModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@T("Profil Kaydi", "Profile Registration")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="profileForm">
                    <div class="modal-body">
                        <div class="mb-2">
                            <label class="form-label" for="profileName">@T("Ad", "Name")</label>
                            <input id="profileName" class="form-control" maxlength="40" required />
                        </div>
                        <div class="mb-2">
                            <label class="form-label" for="profileHandle">@T("Kullanici adi", "Username")</label>
                            <input id="profileHandle" class="form-control" maxlength="40" required />
                        </div>
                        <div>
                            <label class="form-label" for="profileAvatar">@T("Avatar (istege bagli URL)", "Avatar (optional URL)")</label>
                            <input id="profileAvatar" class="form-control" maxlength="240" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@T("Kapat", "Close")</button>
                        <button type="submit" class="btn btn-primary">@T("Kaydet", "Save")</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
