@model KategoriSecici.ViewModels.LoginViewModel
@{
    var isEn = Model.Lang == "en";
    ViewData["Title"] = isEn ? "Sign In" : "Giris Yap";
    string T(string tr, string en) => isEn ? en : tr;
}

<div class="auth-shell">
    <div class="auth-card-wrap">
        <img src="~/images/login-hero.png" alt="hero" class="auth-hero-image" onerror="this.style.display='none'" />
        <div class="card auth-card">
            <div class="card-body p-4">
                <h1 class="auth-title">@T("Hesabina giris yap", "Sign in to your account")</h1>

                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="alert alert-warning py-2">@Model.ErrorMessage</div>
                }

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Lang" />
                    <input type="hidden" asp-for="ReturnUrl" />

                    <label class="form-label auth-label" asp-for="Email">@T("E-posta", "E-mail")</label>
                    <input asp-for="Email" class="form-control auth-input" />
                    <span asp-validation-for="Email" class="text-danger"></span>

                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <label class="form-label auth-label mb-0" asp-for="Password">@T("Parola", "Password")</label>
                    </div>
                    <input asp-for="Password" class="form-control auth-input mt-1" />
                    <span asp-validation-for="Password" class="text-danger"></span>

                    <div class="form-check mt-3 mb-3">
                        <input class="form-check-input" asp-for="RememberMe" />
                        <label class="form-check-label" asp-for="RememberMe">@T("Bir ay boyunca icerde kal", "Stay signed in for one month")</label>
                    </div>

                    <button type="submit" class="btn auth-primary-btn w-100">@T("Devam et", "Continue")</button>
                </form>

                <div class="text-center mt-4">
                    <a class="google-circle-btn" asp-controller="Account" asp-action="GoogleLogin" asp-route-lang="@Model.Lang" asp-route-returnUrl="@Model.ReturnUrl" title="Google ile giris">
                        G
                    </a>
                </div>
            </div>
        </div>
        <p class="auth-bottom-link">
            @T("Hesabiniz yok mu?", "Don't have an account?")
            <a asp-controller="Account" asp-action="Register" asp-route-lang="@Model.Lang" asp-route-returnUrl="@Model.ReturnUrl">@T("Kayit ol.", "Sign up.")</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
