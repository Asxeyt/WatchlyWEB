@{
    var lang = (ViewData["Lang"] as string ?? "tr").ToLowerInvariant();
    var isEn = lang == "en";
    var email = (ViewData["VerifyEmail"] as string) ?? "";
    var sent = (ViewData["VerifySent"] as bool?) == true;
    var fallbackLink = (ViewData["FallbackLink"] as string) ?? "";
    ViewData["Title"] = isEn ? "Verify E-mail" : "E-posta Dogrulama";
    string T(string tr, string en) => isEn ? en : tr;
}

<div class="auth-shell">
    <div class="auth-card-wrap">
        <div class="card auth-card">
            <div class="card-body p-4">
                <h1 class="auth-title">@T("E-postani dogrula", "Verify your e-mail")</h1>
                <p class="mb-3">@T("Kayit tamamlandi. Dogrulama adimi gerekli.", "Registration completed. Verification is required.")</p>
                <p class="mb-3"><strong>@email</strong></p>

                @if (sent)
                {
                    <div class="alert alert-success py-2">@T("Dogrulama maili gonderildi.", "Verification email has been sent.")</div>
                }
                else
                {
                    <div class="alert alert-warning py-2">
                        @T("Mail servisi ayarli degil. Gecici olarak bu linkten dogrulayabilirsin.", "Mail service is not configured. Use this temporary verification link.")
                    </div>
                    @if (!string.IsNullOrWhiteSpace(fallbackLink))
                    {
                        <a class="btn btn-warning" href="@fallbackLink">@T("E-postayi dogrula", "Verify e-mail")</a>
                    }
                }

                <div class="mt-3">
                    <a class="btn btn-outline-light" asp-controller="Account" asp-action="Login" asp-route-lang="@lang">@T("Giris sayfasina don", "Back to login")</a>
                </div>
            </div>
        </div>
    </div>
</div>
