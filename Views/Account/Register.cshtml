@model KategoriSecici.ViewModels.RegisterViewModel
@{
    var isEn = Model.Lang == "en";
    ViewData["Title"] = isEn ? "Sign Up" : "Kaydol";
    string T(string tr, string en) => isEn ? en : tr;
}

<div class="auth-shell">
    <div class="auth-card-wrap">
        <img src="~/images/login-hero.png" alt="hero" class="auth-hero-image" onerror="this.style.display='none'" />
        <div class="card auth-card">
            <div class="card-body p-4">
                <h1 class="auth-title">@T("Yeni hesap olustur", "Create your account")</h1>

                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="alert alert-warning py-2">@Model.ErrorMessage</div>
                }

                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Lang" />
                    <input type="hidden" asp-for="ReturnUrl" />

                    <label class="form-label auth-label" asp-for="DisplayName">@T("Gorunen ad", "Display name")</label>
                    <input asp-for="DisplayName" class="form-control auth-input" />
                    <span asp-validation-for="DisplayName" class="text-danger"></span>

                    <label class="form-label auth-label mt-3" asp-for="Email">@T("E-posta", "E-mail")</label>
                    <input asp-for="Email" class="form-control auth-input" />
                    <span asp-validation-for="Email" class="text-danger"></span>

                    <label class="form-label auth-label mt-3" asp-for="Password">@T("Parola", "Password")</label>
                    <input asp-for="Password" class="form-control auth-input" />
                    <span asp-validation-for="Password" class="text-danger"></span>

                    <label class="form-label auth-label mt-3" asp-for="ConfirmPassword">@T("Parola tekrar", "Confirm password")</label>
                    <input asp-for="ConfirmPassword" class="form-control auth-input" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>

                    <button type="submit" class="btn auth-primary-btn w-100 mt-4">@T("Kaydol", "Sign up")</button>
                </form>

                <div class="text-center mt-4">
                    <a class="google-circle-btn" asp-controller="Account" asp-action="GoogleLogin" asp-route-lang="@Model.Lang" asp-route-returnUrl="@Model.ReturnUrl" title="Google ile giris">
                        G
                    </a>
                </div>
            </div>
        </div>
        <p class="auth-bottom-link">
            @T("Zaten hesabin var mi?", "Already have an account?")
            <a asp-controller="Account" asp-action="Login" asp-route-lang="@Model.Lang" asp-route-returnUrl="@Model.ReturnUrl">@T("Giris yap.", "Sign in.")</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
